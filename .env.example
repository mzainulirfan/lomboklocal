# Copy ke .env.local lalu isi nilainya. JANGAN commit .env.local ke GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# URL publik (tanpa trailing slash) — dipakai metadata & sitemap
NEXT_PUBLIC_SITE_URL=https://lomboklocal.example.com
# Kode verifikasi Google Search Console (isi setelah daftar)
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Opsional (analytics GA4)
# NEXT_PUBLIC_GA_ID=
